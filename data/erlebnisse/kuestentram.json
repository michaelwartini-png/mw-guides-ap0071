  "highlights": {
    "items": [
      {
        "id": "h-1786431817490-1",
        "titel": "Mit der Tram direkt am Meer",
        "kurzbeschreibung": "Auf mehreren Streckenabschnitten fährt die Kusttram unmittelbar an Dünen, Strand und Nordsee entlang – mit freien Blicken aufs Meer direkt aus der Tram.",
        "icon": "view",
        "galerieBildId": "bild-1786431042965-1",
        "reihenfolge": 1,
        "aktiv": true
      },
      {
        "id": "h-1786431858936-2",
        "titel": "Highlight · Reihenfolge 2",
        "kurzbeschreibung": "Kurzbeschreibung",
        "icon": "view",
        "galerieBildId": "bild-1786431149674-4",
        "reihenfolge": 2,
        "aktiv": true
      },
      {
        "id": "h-1786436990239-3",
        "titel": "Die gesamte belgische Küste mit nur einer Linie",
        "kurzbeschreibung": "Von De Panne bis Knokke verbindet die Kusttram nahezu alle bekannten Badeorte der belgischen Nordseeküste – ohne Umsteigen.",
        "icon": "view",
        "galerieBildId": "bild-1786431135768-3",
        "reihenfolge": 3,
        "aktiv": true
      },
      {
        "id": "h-1786437222940-4",
        "titel": "Einfach aussteigen und weiterfahren",
        "kurzbeschreibung": "Dank des dichten Takts lassen sich Strände, Promenaden, Beachbars und Sehenswürdigkeiten flexibel erkunden. Die nächste Bahn bringt dich bequem weiter.",
        "icon": "view",
        "galerieBildId": "bild-1786432092834-6",
        "reihenfolge": 4,
        "aktiv": true
      },
      {
        "id": "h-1786437274955-5",
        "titel": "Die längste Straßenbahnlinie der Welt",
        "kurzbeschreibung": "Rund 67 Kilometer Strecke und 67 Haltestellen machen die Kusttram zu einer der außergewöhnlichsten Straßenbahnlinien Europas.",
        "icon": "view",
        "galerieBildId": "bild-1786431085251-2",
        "reihenfolge": 5,
        "aktiv": true
      },
      {
        "id": "h-1786437316167-6",
        "titel": "Jeder Küstenort hat seinen eigenen Charakter",
        "kurzbeschreibung": "Elegante Belle-Époque-Orte wie De Haan, lebhafte Seebäder wie Oostende oder ruhige Dünenlandschaften – jede Etappe bietet ein anderes Erlebnis.",
        "icon": "view",
        "galerieBildId": "bild-1786431149674-4",
        "reihenfolge": 6,
        "aktiv": false
      },
      {
        "id": "h-1786437362389-7",
        "titel": "Perfekt für einen individuellen Küstentag",
        "kurzbeschreibung": "Ob ein kurzer Strandbesuch, ein Restaurant, eine Wanderung durch die Dünen oder mehrere Stopps – die Kusttram eignet sich ideal für spontane Entdeckungen.",
        "icon": "view",
        "galerieBildId": "bild-1786431168617-5",
        "reihenfolge": 7,
        "aktiv": true
      }
    ]
  },
  "mwGuidesTipps": {
    "items": [
      {
        "id": "tipp-1786445171120-1",
        "typ": "standard",
        "thema": "beste-besuchszeit",
        "ueberschrift": "Bei gutem Wetter besonders schön",
        "beschreibung": "Die Kusttram lebt vom Blick auf Küste, Dünen und Meer. Bei trockenem, möglichst klarem Wetter lohnt sich die Fahrt besonders. Im Sommer sind die Badeorte allerdings deutlich voller.",
        "prioritaet": "",
        "galerieBildId": "bild-1786431168617-5",
        "reihenfolge": 1,
        "aktiv": true
      },
      {
        "id": "tipp-1786445227575-2",
        "typ": "standard",
        "thema": "beste-besuchszeit",
        "ueberschrift": "Für die Aussicht den Sitzplatz bewusst wählen",
        "beschreibung": "Auf den schönsten Küstenabschnitten entscheidet die Fahrtrichtung über den besseren Meerblick. Nicht einfach irgendwo einsteigen – bei MW Guides zeigen wir dir, auf welcher Seite sich das Sitzen besonders lohnt.",
        "prioritaet": "",
        "galerieBildId": "bild-1786431042965-1",
        "reihenfolge": 2,
        "aktiv": true
      },
      {
        "id": "tipp-1786445241768-3",
        "typ": "frei",
        "ueberschrift": "Nicht die gesamte Strecke einfach durchfahren",
        "beschreibung": "Die Kusttram wird besonders interessant, wenn du unterwegs aussteigst. Plane lieber weniger Orte mit genügend Zeit ein, statt möglichst viele Haltestellen abzuhaken.",
        "prioritaet": "",
        "galerieBildId": "bild-1786431135768-3",
